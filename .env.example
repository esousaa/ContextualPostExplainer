OPENAI_API_KEY=
# gpt-4o is the safe baseline; upgrade to gpt-5.1 when your key has access.
OPENAI_GENERATION_MODEL=gpt-4o
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vision step uses the same model as generation.
OPENAI_VISION_MODEL=gpt-4o

# Host ports used by Docker Compose and local make up.
# Change these if 8000 or 5173 are already occupied on the evaluator machine.
APP_BACKEND_PORT=8000
APP_FRONTEND_PORT=5173
# make up and Docker Compose derive CORS from APP_FRONTEND_PORT.
# If you run the backend manually with make backend-run and change the frontend port,
# update BACKEND_CORS_ORIGINS to match.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Required only for live mode.
# Eval mode uses local fixtures and does not require these keys.
SEARCH_PROVIDER=tavily
# Supported values: brave, tavily, composite.
# composite uses every configured provider key below and merges the results.
# Project validation can use SEARCH_PROVIDER=composite while Brave free access is active
# through 2026-06-01 and both keys are configured.
BRAVE_API_KEY=
TAVILY_API_KEY=

EVAL_FIXTURE_DIR=eval/fixtures

# Optional labels used by comparative analysis runs.
COMPARISON_GROUP_ID=
COMPARISON_CONFIG_ID=
